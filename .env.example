# Capstiller Gear Ask v1 — x402 pay-to-ask
PORT=4022

# Base mainnet receiving wallet
PAY_TO=0xB61f7Eb307f6580D6619115b8ef8CFbf693F73Ff

# $CAPH / CAPhet on Base (18 decimals; name=CAPhet; version() missing → Permit2)
CAPH_TOKEN=0x1d1bcd1459259429accde23e24e1782f83e97ba3

# Target economics (USD label — settlement is CAPH TokenAmount, not USDC)
ASK_PRICE_USD=0.01

# Preferred: USD price of 1 CAPH → atomic = usd/caphUsd * 1e18
# CAPH_USD_PRICE=0.01

# Or set explicit atomic amount. If neither set, PLACEHOLDER 1e16 is used.
# ASK_CAPH_ATOMIC=10000000000000000

# Facilitator (CDP mainnet default). Cap may need CDP auth — or use PayAI.
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# X402_FACILITATOR_URL=https://facilitator.payai.network

# Free asks for local UI testing (also set VITE_X402_DEV_BYPASS=1)
# X402_DEV_BYPASS=1

# Axle daily-close secret (required for POST /api/daily-close)
DAILY_CLOSE_SECRET=change-me-to-a-long-random-string

# Optional Base RPC for Basename reverse lookup
# BASE_RPC_URL=https://mainnet.base.org

# Client (Vite)
# VITE_X402_DEV_BYPASS=1
# VITE_CAPH_TOKEN=0x1d1bcd1459259429accde23e24e1782f83e97ba3
